# 1. Buka https://neon.tech dan buat akun gratis.
# 2. Buat project baru (region: Singapore untuk Asia).
# 3. Salin "Pooled connection string" dari halaman Connection Details.
# 4. Tempel ke DATABASE_URL di bawah ini.
#    Contoh: postgresql://USERNAME:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USERNAME:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Ganti dengan string acak yang panjang dan unik.
AUTH_SECRET="ganti_dengan_secret_acak_yang_panjang_dan_unik_9876543210"

# URL website. Untuk pengembangan lokal biarkan localhost.
# Setelah deploy ke Vercel, ganti dengan https://nama-aplikasi.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set true only after adding a Vercel Blob store to the Vercel project.
NEXT_PUBLIC_BLOB_UPLOAD_ENABLED="false"
# BLOB_READ_WRITE_TOKEN is created automatically when a Blob store is connected in Vercel.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
