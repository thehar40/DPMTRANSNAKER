# 1. Buka https://neon.tech dan buat akun gratis.
# 2. Buat project baru (region: Singapore untuk Asia).
# 3. Salin "Pooled connection string" dari halaman Connection Details.
# 4. Tempel ke DATABASE_URL di bawah ini.
#    Contoh: postgresql://USERNAME:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USERNAME:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Ganti dengan string acak yang panjang dan unik.
AUTH_SECRET="ganti_dengan_secret_acak_yang_panjang_dan_unik_9876543210"

# URL website. Untuk pengembangan lokal biarkan localhost.
# Setelah deploy ke Vercel, ganti dengan https://nama-aplikasi.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Upload file dari panel admin: penyimpanan yang dipakai.
# Opsi: local (folder public/uploads), blob (Vercel Blob),
#       supabase (Supabase Storage), gcs (Google Cloud Storage).
NEXT_PUBLIC_STORAGE_PROVIDER="local"

# ----- Upload via Supabase Storage (opsional, jika provider = supabase) -----
# Buat project di https://supabase.com, buat bucket PUBLIK (misal: dpmtransnaker),
# lalu isi data di bawah (Project Settings -> API).
# LAST_WARNING: aktifkan kebijakan izin upload untuk peran anon pada bucket.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
NEXT_PUBLIC_SUPABASE_BUCKET="dpmtransnaker"

# ----- Upload via Vercel Blob (opsional, jika provider = blob) -----
# BLOB_READ_WRITE_TOKEN otomatis tersedia di Vercel setelah Blob Storage dibuat.
# Untuk pengembangan lokal, salin dari Vercel -> Settings -> Environment Variables.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ----- Upload via Google Cloud Storage (opsional, jika provider = gcs) -----
# Catatan: perlu service account key JSON yang mungkin diblokir oleh kebijakan
# organisasi GCP (iam.disableServiceAccountKeyCreation). Jika diblokir,
# gunakan provider "supabase" atau "blob".
# GCS_BUCKET="nama-bucket"
# GCS_PROJECT_ID="project-id"
# GCS_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Jika memakai Vercel, seluruh variabel yang dibutuhkan tersedia otomatis
# (misal VERCEL=1) sehingga upload lokal tidak diaktifkan pada serverless.
